# Copy to .env (git-ignored). Real environment variables take precedence over this file.
# Any Config field can be set as ARXIV_TLDR_<FIELD>; lists are comma-separated.

# Arxiv categories whose new announcements become Candidates
# ARXIV_TLDR_WATCHED_CATEGORIES=q-fin,stat.ME,econ.EM

# Path of the SQLite database
# ARXIV_TLDR_DB_PATH=arxiv-tldr.db
